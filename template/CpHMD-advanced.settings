########################################
#
###  Start of CpHMD settings (pHmdp) ###
#
########################################
export GPU=0                # Flag to activate (1) or deactivate (0) GPU support (default:0)
export nCPU=8               # Number of CPUs to be used in parallel (default:8)
export SysName="Protein"    # Name of our protein or system (default:Protein)
export SimTime=25           # Total time in ns that CpHMD will be rans (default 1 ns)
export StartTime=0          # Start simulation time in ns (default 0 ns)
export ffID=G54a7pH         # Force fields: G54a7pH or CHARMM36pH or Amber14SBpH (default:G54a7pH)
export pH=7.2               # Solution pH (default 7.0)
export sites="all 1N XXXC"  # list of residues to titrate or "all" to titrate every residue. Termini should be defined with N and C after the residue number
export temp=310.0           # Temperature (Kelvin)
export ionicstr=0.1         # Ionic Strength (moles/litre)
export RelaxSteps=100       # Solvent relaxation time in steps 
export EffectiveSteps=10000 # Effective time in steps (real simulation time)
#
#######################
#
# System definitions 
#
######################
export memb=0               # Flag for membrane systems. If active index must contain Onetail/Monotail/Bitail (default 0)
export multiple_solutes=0   # Defines if there are multiple solutes that need to be treated to correct PBC (systems with 2 solutes interacting with each other need to set this to 1)
export include_itp=0        # Correctly treats systems pbc when solute is included as itp. (default 0)
#
##########################################
#
# --           PB/MC settings         -- #
#
##########################################
export epsin=2.0            # Dielectric constant of molecular interior
export epssol=80.0          # Dielectric constant of the solvent 
export PBdim=0              # dimensions in the PB PBC settings (0 for protein; 2 for membrane)
export cutoff=-1            # Cutoff (in nm) for background and pairwise interactions (-1 will not cutoff)
export GridSize=81          # PB grid size (multiply by ~1 Angstr) (was 81)
export scaleP=1.0           # scale large box (1.0 -> 1 Angstrm)
export scaleM=4.0           # scale focusing box (4.0 -> 1/4 Angstrm)
export bndcon=4             # Potential at Boundary of large box (4 -> Coul)
export maxc=0.01            # The convergence threshold values
export pot=0.0              # Electrostatic potential (mV).
export offset=2000          # Integer higher than residue number .gro 
export seed=1234567         # Monte Carlo seed used in program petit.

##########################################
#
# --    Reduced Titration settings    -- #
#
##########################################
export ReduceTitration=0
export RTThreshold=0.01
export RTInterval=5
## RT debug ##
export write_states="y"

############################################
#
# --    Plumed MetaDynamics settings    -- #
#
############################################

export plumed=0               # turn plumed on or off (1/0)
export plumedtype=grid        #static/grid/hill
export colvar_name="colvar"
export colvar_stride=1000     #Should be equal to the nstxtcout-compressed number of timesteps (ex.: 1000 * 0.002 = 2 ps)
export grid_name="GRIDS"      # name of the GRIDS file
export hills="HILLS"          # name of the HILLS file

##########################################
#
# -- Input File Location (full PATHs) -- #
#
##########################################
export TOPin="penta.top"    # The topology of your system
export GROin="penta.gro"    # The initial (gro) file
export NDXin="index.ndx"    # Index must contain "System/Protein/Solute/SOL" and "Onetail/Monotail/Bitail" for membrane
export PosRe=""             # File to use position restraints in production

####################################
#
# -- Input Directories Location -- #
#
####################################
export CpHDIR=""            # CpHMD distribution
export GroDIR=""            # GROMACS Binaries
export DelphiDir=""         # DELPHI Programs and scripts
export StDIR=""             # Location of .st files
export PetitDIR=""          # Petit program
export ffDIR=""             # Forcefield folder
export DatabaseDIR=""       # Location of the Delphi databases

############################
#                          #  
## -- MDrun parameters -- ##
#                          #
############################
export mdruncpu="mdrun -nt $nCPU -pin auto "                       # Define which command should be used for CPU parallel run
export mdrungpu="mdrun -ntmpi 1 -ntomp $nCPU -gpu_id 0 -pin auto " # Define which command should be used for GPU run

########################################
#
###  Start of mdp file for CpHMD     ###
#
########################################
#mdp# 
#mdp# define                 = 
#mdp# integrator             =  md
#mdp# tinit                  =  0.0 ; Overridden with the value calculated by CpHMD
#mdp# dt                     =  0.002    ; ps !
#mdp# nsteps                 =  10000 ; Overridden with the value from settings
#mdp# nstcalcenergy          =  5
#mdp# nstcomm                =  5
#mdp# nstxout-compressed     =  5000
#mdp# compressed-x-precision =  1000
#mdp# nstenergy              =  5000
#mdp# nstxout                =  0
#mdp# nstvout                =  0
#mdp# nstfout                =  0
#mdp# nstlog                 =  0
#mdp# ns_type		     =  grid
#mdp# 
#mdp# ; PME 
#mdp# coulombtype         = PME
#mdp# nstlist             = 10
#mdp# rlist               = 1.4
#mdp# fourierspacing      = 0.12
#mdp# rcoulomb            = 1.4
#mdp# pme-order           = 4
#mdp# rvdw                = 1.4
#mdp# cutoff-scheme       = verlet
#mdp# 
#mdp# vdwtype             = cut-off
#mdp# 
#mdp# ; Energy monitoring 
#mdp# ; (ions - when present - should be added to the SOL group in the index file)
#mdp# energygrps          =  Protein SOL
#mdp# 
#mdp# ; v-rescaletemperature coupling is on available groups
#mdp# ; This thermostat is similar to Berendsen coupling, but the stochastic 
#mdp# ; term ensures that a proper canonical ensemble is generated.
#mdp# Tcoupl              =  v-rescale
#mdp# tc-grps             =  Protein  SOL
#mdp# tau_t               =  1       1
#mdp# ref_t               =  310.0   310.0 ; Overridden with the value from settings   
#mdp# 
#mdp# ; Isotropic pressure coupling is now on
#mdp# Pcoupl              =  Parrinello-Rahman
#mdp# Pcoupltype          =  isotropic
#mdp# tau_p               =  5.0
#mdp# compressibility     =  4.5e-5
#mdp# ref_p               =  1.0
#mdp# 
#mdp# ; lincs_order value of 8 works better than 4
#mdp# constraint_algorithm = lincs
#mdp# lincs_order          = 8
#mdp# constraints          = all-bonds
#mdp# lincs-warnangle      = 90

###########################################
#
###  Start of fixgro file for CpHMD     ###
#
###########################################
# This file will only be used when 2 chains are present or if 
# include_itp=1 flag is given! 
#
#fixgro# G Protein
#fixgro# a 1 1367
#fixgro# 
#fixgro# # Groups to be (sequentially) assembled:
#fixgro# A Protein
#fixgro# 
#fixgro# # Groups to be centered along each of the three box vectors:
#fixgro# C Protein Protein Protein W W W
#fixgro# 
#fixgro# # Use PBC "P System System None" along each of the three box vectors:
#fixgro# P Protein Protein Protein

############################################
#
###  Start of plumed file for PLUMED     ###
#
############################################
# Check if the timesteps and temperature values are consistent with previous settings
#plumed# # Activate MOLINFO functionalities
#plumed# MOLINFO STRUCTURE=/home/noliveira/CpHMD/test-systems/CpHMD-3.4/GROMOS/HEWL-noRT/test-cphmd-plumed/rep1.pdb
#plumed# RESTART # Do not remove this line. This is ignored for the first cycle in each block
#plumed# chi: TORSION ATOMS=38,39,47,61
#plumed# ade:  GROUP ATOMS=58,52,61
#plumed# uri1: GROUP ATOMS=26,22,18
#plumed# uri2: GROUP ATOMS=92,88,84
#plumed# eRMSD: ERMSD REFERENCE=/home/noliveira/CpHMD/test-systems/CpHMD-3.4/GROMOS/HEWL-noRT/test-cphmd-plumed/rep1.pdb ATOMS=ade,uri1,uri2 
#plumed# # Activate well-tempered metadynamics in phi
#plumed# metad: METAD ARG=chi,eRMSD PACE=500 HEIGHT=2.0 SIGMA=0.35,0.1 BIASFACTOR=8 TEMP=300 FILE=&hills GRID_MIN=-pi,0 GRID_MAX=pi,2 GRID_WSTRIDE=500 GRID_WFILE=&grid_name GRID_RFILE=&grid_name 
#plumed#    # Deposit a Gaussian every 500 time steps, with initial height 
#plumed#    # equal to 1.2 kJ/mol and bias factor equal to 2 
#plumed#    
#plumed#    # Gaussian width (sigma) should be chosen based on the CV fluctuations in unbiased run 
#plumed#    # try 1/2 or 1/3 of the estimated fluctuations 
#plumed#    
#plumed#    # Gaussians will be written to file and also stored on grid 
#plumed# 
#plumed# # Print both collective variables on COLVAR file every colvar_stride steps (Xps)
#plumed# PRINT ARG=chi,eRMSD,metad.bias  STRIDE=&colvar_stride FILE=&colvar_name 